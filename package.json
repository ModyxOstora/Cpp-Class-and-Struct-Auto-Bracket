{
  "name": "cpp-class-bracket",
  "displayName": "C++ Class/Struct Auto Bracket",
  "description": "Automatically closes class/struct/enum blocks with }; when pressing Shift+[",
  "version": "1.2.8",
  "icon": "icon.png",
  "publisher": "MoayadBedair",
  "repository": {
    "type": "git",
    "url": "https://github.com/ModyxOstora/Cpp-Class-and-Struct-Auto-Bracket.git"
  },
  "bugs": {
    "url": "https://github.com/ModyxOstora/Cpp-Class-and-Struct-Auto-Bracket/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cpp-class-bracket.insertClassBracket",
        "title": "C++ Auto Bracket: Insert Bracket"
      },
      {
        "command": "cpp-class-bracket.forceInsertClassBracket",
        "title": "C++ Auto Bracket: Force Insert Bracket (Override)"
      },
      {
        "command": "cpp-class-bracket.smartBackspace",
        "title": "C++ Auto Bracket: Smart Backspace"
      },
      {
        "command": "cpp-class-bracket.toggleInlineMode",
        "title": "C++ Auto Bracket: Toggle Inline Mode"
      }
    ],
    "configuration": {
      "title": "C++ Class/Struct Auto Bracket",
      "properties": {
        "cppClassBracket.inlineMode": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, inserts {}; with the cursor between { and } instead of expanding to multiple lines."
        }
      }
    },
    "keybindings": [
      {
        "key": "shift+[",
        "command": "cpp-class-bracket.insertClassBracket",
        "when": "editorTextFocus && (editorLangId == cpp || editorLangId == c)"
      },
      {
        "key": "shift+alt+[",
        "command": "cpp-class-bracket.forceInsertClassBracket",
        "when": "editorTextFocus && (editorLangId == cpp || editorLangId == c)"
      },
      {
        "key": "backspace",
        "command": "cpp-class-bracket.smartBackspace",
        "when": "editorTextFocus && (editorLangId == cpp || editorLangId == c)"
      },
      {
        "key": "ctrl+shift+;",
        "command": "cpp-class-bracket.toggleInlineMode",
        "when": "editorTextFocus && (editorLangId == cpp || editorLangId == c)"
      }
    ]
  }
}